"""Generate Claude Code subagents and project skill pointers from the tracked Codex definitions.

Codex role TOML files (`.codex/config.toml` entries and `.codex/agents/*.toml`) and the shared
project skills in `.agents/skills/` stay the single source of truth. This script renders
`.claude/agents/<role>.md` and `.claude/skills/<skill>/SKILL.md` pointers so Claude Code gets
the same roles and project workflow. Run with `--check` to detect drift without writing.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path, PurePosixPath
import re
import sys
import tomllib

WORKSPACE = Path(__file__).resolve().parents[1]
GENERATOR = 'scripts/sync_claude_env.py'
MARKER = f'<!-- GENERATED by {GENERATOR}'
# Roles whose Codex instructions say read-only/report-only get no Edit/Write tools.
READ_ONLY_ROLES = frozenset({'gstack_planner', 'gstack_reviewer', 'gstack_investigator', 'gstack_docs', 'gstack_qa',
                             'jipdam_planner', 'jipdam_reviewer'})
READ_ONLY_TOOLS = 'Read, Grep, Glob, Bash'
ROLE_NAME = re.compile(r'[a-z][a-z0-9_-]{0,63}\Z')
SKILL_NAME = re.compile(r'[a-z0-9][a-z0-9-]{0,63}\Z')

CLAUDE_MAPPING = """Claude Code mapping: the "parent" is the main Claude Code session that delegated this task.
Paths such as `.agents/skills/<name>/SKILL.md` are shared project files; read them with the Read tool.
If a referenced `.agents/skills/gstack-*/SKILL.md` is absent because gstack is installed for the Claude
host, read the same skill under `.claude/skills/gstack-*/SKILL.md` instead. "Spawn agents" means the
Agent tool. Codex-specific wording applies to Claude Code in the same role. Claude Code permission and
Git approval settings stay host-owned; this role does not widen them."""


def _require(condition: bool, message: str) -> None:
    if not condition:
        raise ValueError(message)


def _quote(value: str) -> str:
    # JSON strings are valid YAML double-quoted scalars and survive ':' and '#'.
    return json.dumps(value.strip(), ensure_ascii=False)


def _relative(root: Path, path: Path) -> str:
    resolved = path.resolve()
    _require(resolved.is_relative_to(root), f'Definition escapes the repository: {path}')
    return resolved.relative_to(root).as_posix()


def parse_frontmatter(text: str) -> dict[str, str]:
    match = re.match(r'\A---\r?\n(.*?)\r?\n---(?:\r?\n|\Z)', text, re.S)
    _require(match is not None, 'Missing YAML frontmatter')
    fields = {}
    for line in match.group(1).splitlines():
        key, separator, value = line.partition(':')
        if not separator or not key.strip() or line[:1].isspace():
            continue
        value = value.strip()
        if value.startswith('"'):
            value = json.loads(value)
        elif len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1].replace("''", "'")
        fields[key.strip()] = value
    return fields


def codex_roles(root: Path = WORKSPACE) -> list[dict]:
    """Collect Codex roles from the project config and the role directory."""
    root = root.resolve()
    roles: dict[str, dict] = {}
    config_path = root / '.codex/config.toml'
    config = tomllib.loads(config_path.read_text(encoding='utf-8')) if config_path.is_file() else {}
    for key, entry in (config.get('agents') or {}).items():
        if not isinstance(entry, dict) or 'config_file' not in entry:
            continue
        source = root / '.codex' / entry['config_file']
        data = tomllib.loads(source.read_text(encoding='utf-8'))
        _require(data.get('name', key) == key, f'{source}: name differs from config key {key}')
        roles[key] = {'name': key, 'description': entry.get('description') or data.get('description', ''),
                      'instructions': data.get('developer_instructions', ''),
                      'source': _relative(root, source)}
    for source in sorted((root / '.codex/agents').glob('*.toml')):
        data = tomllib.loads(source.read_text(encoding='utf-8'))
        name = data.get('name', source.stem)
        _require(name not in roles, f'Duplicate Codex role: {name}')
        roles[name] = {'name': name, 'description': data.get('description', ''),
                       'instructions': data.get('developer_instructions', ''),
                       'source': _relative(root, source)}
    for role in roles.values():
        _require(ROLE_NAME.fullmatch(role['name']) is not None, f'Invalid role name: {role["name"]}')
        _require(bool(role['description'].strip()), f'{role["source"]}: missing description')
        _require(bool(role['instructions'].strip()), f'{role["source"]}: missing developer_instructions')
    return [roles[name] for name in sorted(roles)]


def project_skills(root: Path = WORKSPACE) -> list[dict]:
    """Collect tracked, non-gstack shared skills from `.agents/skills/`."""
    root = root.resolve()
    skills = []
    base = root / '.agents/skills'
    for folder in sorted(base.iterdir()) if base.is_dir() else []:
        if folder.name == 'gstack' or folder.name.startswith('gstack-') or not (folder / 'SKILL.md').is_file():
            continue
        meta = parse_frontmatter((folder / 'SKILL.md').read_text(encoding='utf-8'))
        _require(meta.get('name') == folder.name and SKILL_NAME.fullmatch(folder.name) is not None,
                 f'{folder}/SKILL.md: name must match its folder')
        _require(bool(meta.get('description', '').strip()), f'{folder}/SKILL.md: missing description')
        skills.append({'name': folder.name, 'description': meta['description'],
                       'source': _relative(root, folder / 'SKILL.md')})
    return skills


def render_role(role: dict) -> str:
    lines = ['---', f'name: {role["name"]}', f'description: {_quote(role["description"])}']
    if role['name'] in READ_ONLY_ROLES:
        lines.append(f'tools: {READ_ONLY_TOOLS}')
    lines += ['---', f'{MARKER} from {role["source"]}; edit the source and rerun. -->', '',
              CLAUDE_MAPPING, '', role['instructions'].strip(), '']
    return '\n'.join(lines)


def render_skill(skill: dict) -> str:
    return '\n'.join([
        '---', f'name: {skill["name"]}', f'description: {_quote(skill["description"])}', '---',
        f'{MARKER} from {skill["source"]}; edit the source and rerun. -->', '',
        f'This is the Claude Code entry for the shared project skill `{skill["name"]}`.',
        f'Read `{skill["source"]}` in full with the Read tool and follow it. That file is the single',
        'source of truth; its relative paths are resolved from the workspace root.', ''])


def expected_files(root: Path = WORKSPACE) -> dict[str, str]:
    files = {f'.claude/agents/{role["name"]}.md': render_role(role) for role in codex_roles(root)}
    files.update({f'.claude/skills/{skill["name"]}/SKILL.md': render_skill(skill)
                  for skill in project_skills(root)})
    return files


def _generated(path: Path) -> bool:
    return path.is_file() and MARKER in path.read_text(encoding='utf-8')


def _existing_generated(root: Path) -> set[str]:
    found = set()
    agents = root / '.claude/agents'
    for path in agents.rglob('*.md') if agents.is_dir() else []:
        if _generated(path):
            found.add(path.relative_to(root).as_posix())
    skills = root / '.claude/skills'
    for path in skills.glob('*/SKILL.md') if skills.is_dir() else []:
        if not path.parent.name.startswith('gstack') and _generated(path):
            found.add(path.relative_to(root).as_posix())
    return found


def sync(root: Path = WORKSPACE, check: bool = False) -> list[str]:
    """Write (or with check=True only report) generated files that differ from the sources."""
    root = root.resolve()
    expected = expected_files(root)
    claude_root = (root / '.claude').resolve()
    _require(claude_root.parent == root, 'Unexpected .claude location')
    changes = []
    for name, content in sorted(expected.items()):
        path = root / name
        _require(path.resolve().is_relative_to(claude_root), f'Refusing redirected output: {name}')
        if path.is_file() and path.read_text(encoding='utf-8') == content:
            continue
        _require(not path.exists() or _generated(path), f'Refusing to overwrite user-owned file: {name}')
        changes.append(name)
        if not check:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding='utf-8', newline='\n')
    for name in sorted(_existing_generated(root) - set(expected)):
        changes.append(f'{name} (stale)')
        if not check:
            path = root / name
            path.unlink()
            if path.parent.parent.name == 'skills' and not any(path.parent.iterdir()):
                path.parent.rmdir()
    return changes


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--check', action='store_true', help='Report drift and exit 1 without writing')
    args = parser.parse_args()
    changes = sync(check=args.check)
    if args.check and changes:
        print('Claude Code files are out of sync; run python -X utf8 ' + GENERATOR, file=sys.stderr)
        for name in changes:
            print(f'  {PurePosixPath(name)}', file=sys.stderr)
        sys.exit(1)
    total = len(expected_files())
    if args.check:
        print(f'Claude Code files in sync: {total} generated files', flush=True)
    else:
        print(f'Updated {len(changes)} of {total} generated Claude Code files', flush=True)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, tomllib.TOMLDecodeError) as exc:
        print(f'Claude sync failed: {exc}', file=sys.stderr)
        sys.exit(1)
