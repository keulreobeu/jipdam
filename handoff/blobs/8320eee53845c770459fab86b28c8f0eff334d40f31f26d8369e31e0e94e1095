"""Claude Code project environment: Atlassian MCP, subagent parity and project skill discovery."""
from pathlib import Path
import json
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from sync_claude_env import (MARKER, READ_ONLY_TOOLS, codex_roles, expected_files, parse_frontmatter,
                             project_skills, sync)

CONFIG = '''[agents]
max_concurrent_threads_per_session = 2

[agents.gstack_reviewer]
description = "읽기 전용 리뷰: 결함을 보고합니다."
config_file = "../tooling/codex-agents/gstack_reviewer.toml"

[agents.gstack_committer]
description = "Git 게시를 전담합니다."
config_file = "../tooling/codex-agents/gstack_committer.toml"
'''


class ClaudeEnvironmentTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='claude env ')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.write('.codex/config.toml', CONFIG)
        self.write('tooling/codex-agents/gstack_reviewer.toml',
                   'developer_instructions = """\nReview only. Do not mutate Git.\n"""\n')
        self.write('tooling/codex-agents/gstack_committer.toml',
                   'developer_instructions = """\nPublish the frozen snapshot.\n"""\n')
        self.write('.codex/agents/jipdam_engineer.toml', 'name = "jipdam_engineer"\n'
                   'description = "Implement one bounded job."\n'
                   'developer_instructions = """\nEdit only scope_paths.\n"""\n')
        self.write('.agents/skills/jipdam-workflow/SKILL.md',
                   '---\nname: jipdam-workflow\ndescription: Apply the Spec: Task contracts.\n---\n\nBody\n')
        self.write('.agents/skills/gstack-review/SKILL.md', '---\nname: gstack-review\ndescription: x\n---\n')

    def write(self, name, text):
        path = self.root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text, encoding='utf-8')
        return path

    def test_mcp_config_declares_only_official_atlassian_http_server(self):
        config = json.loads((ROOT / '.mcp.json').read_text(encoding='utf-8'))
        self.assertEqual(config, {'mcpServers': {'atlassian': {
            'type': 'http', 'url': 'https://mcp.atlassian.com/v2/mcp/'}}})

    def test_every_codex_role_has_matching_claude_subagent(self):
        sync(self.root)
        roles = codex_roles(self.root)
        self.assertEqual([r['name'] for r in roles], ['gstack_committer', 'gstack_reviewer', 'jipdam_engineer'])
        for role in roles:
            text = (self.root / f'.claude/agents/{role["name"]}.md').read_text(encoding='utf-8')
            meta = parse_frontmatter(text)
            self.assertEqual(meta['name'], role['name'])
            self.assertEqual(meta['description'], role['description'])
            self.assertIn(role['instructions'].strip(), text)
            self.assertIn(f'from {role["source"]}', text)
        reviewer = parse_frontmatter((self.root / '.claude/agents/gstack_reviewer.md').read_text(encoding='utf-8'))
        committer = parse_frontmatter((self.root / '.claude/agents/gstack_committer.md').read_text(encoding='utf-8'))
        self.assertEqual(reviewer['tools'], READ_ONLY_TOOLS)
        self.assertNotIn('Edit', reviewer['tools'])
        self.assertNotIn('tools', committer)

    def test_check_mode_reports_drift_and_stale_files_without_writing(self):
        sync(self.root)
        self.assertEqual(sync(self.root, check=True), [])
        self.write('tooling/codex-agents/gstack_reviewer.toml', 'developer_instructions = """\nChanged.\n"""\n')
        stale = self.write('.claude/agents/old_role.md', f'---\nname: old_role\n---\n{MARKER} from x -->\n')
        before = (self.root / '.claude/agents/gstack_reviewer.md').read_text(encoding='utf-8')
        self.assertEqual(sync(self.root, check=True),
                         ['.claude/agents/gstack_reviewer.md', '.claude/agents/old_role.md (stale)'])
        self.assertEqual((self.root / '.claude/agents/gstack_reviewer.md').read_text(encoding='utf-8'), before)
        self.assertTrue(stale.exists())
        sync(self.root)
        self.assertFalse(stale.exists())
        self.assertEqual(sync(self.root, check=True), [])

    def test_user_owned_claude_files_are_never_overwritten_or_removed(self):
        owned = self.write('.claude/agents/gstack_reviewer.md', '---\nname: gstack_reviewer\n---\nMine\n')
        custom = self.write('.claude/agents/my_role.md', '---\nname: my_role\n---\nMine\n')
        with self.assertRaisesRegex(ValueError, 'user-owned'):
            sync(self.root)
        self.assertEqual(owned.read_text(encoding='utf-8'), '---\nname: gstack_reviewer\n---\nMine\n')
        owned.unlink()
        sync(self.root)
        self.assertTrue(custom.exists())

    def test_project_skill_pointers_match_shared_skills_and_skip_gstack(self):
        sync(self.root)
        self.assertEqual([s['name'] for s in project_skills(self.root)], ['jipdam-workflow'])
        pointer = (self.root / '.claude/skills/jipdam-workflow/SKILL.md').read_text(encoding='utf-8')
        meta = parse_frontmatter(pointer)
        self.assertEqual(meta, {'name': 'jipdam-workflow', 'description': 'Apply the Spec: Task contracts.'})
        self.assertIn('.agents/skills/jipdam-workflow/SKILL.md', pointer)
        self.assertFalse((self.root / '.claude/skills/gstack-review').exists())

    def test_repository_claude_files_are_in_sync(self):
        self.assertEqual(sync(ROOT, check=True), [])
        names = set(expected_files(ROOT))
        for role in ('gstack_committer', 'gstack_reviewer', 'jipdam_engineer', 'jipdam_evaluator'):
            self.assertIn(f'.claude/agents/{role}.md', names)
        self.assertIn('.claude/skills/jipdam-workflow/SKILL.md', names)


if __name__ == '__main__':
    unittest.main()
